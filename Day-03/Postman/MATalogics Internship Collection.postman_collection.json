{
  "info": {
    "_postman_id": "b76e534a-3ffc-44ad-8db1-9ac830a005a3",
    "name": "MATalogics Internship Collection",
    "description": "Day-03 Module 3 practice collection. Demonstrates GET, POST, collection variables, authorization and export using the public JSONPlaceholder test API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "practiceUrl",
      "value": "https://jsonplaceholder.typicode.com",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "demo-bearer-token-12345",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "GET - Practice (fetch a post)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{practiceUrl}}/posts/{{postId}}",
          "host": [
            "{{practiceUrl}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        },
        "description": "Demonstrates a GET request plus the {{postId}} collection variable."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has an id\", function () {",
              "    pm.expect(pm.response.json()).to.have.property(\"id\");",
              "});"
            ]
          }
        }
      ]
    },
